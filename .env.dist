# Copiar a .env y completar los change-me. El .env NO se versiona.

## GENERAL
# Tag de las dos imágenes: dev (punta de la rama dev) o un release (0.2.0).
IMAGES_TAG=dev
ENVIRONMENT=dev
# La red del nginx que hace de ingress, y el dominio que sirve. La api queda en
# api.${DOMAIN} y la consola de MinIO en minio.${DOMAIN}.
INGRESS_NETWORK=server-nginx
DOMAIN=telescope.dev.grava.io

## DATABASE
POSTGRES_DB=telescope-db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=change-me

## API
# OBLIGATORIO: sin esto el compose no arranca. openssl rand -base64 32.
# Cambiarlo cierra todas las sesiones.
JWT_SECRET=change-me
DB_SSLMODE=disable
GIN_MODE=release
MAX_FILE_SIZE=10485760
# Vacío = sólo la web (https://${DOMAIN}).
CORS_ALLOW_ORIGINS=https://telescope.dev.grava.io

## WEB
# URL de la api como la ve el navegador. Vacío = https://api.${DOMAIN}.
API_URL=

## GOOGLE OAuth (opcional). El mismo client id para api y web; vacío = sin Google.
# En Google Cloud Console, https://${DOMAIN} tiene que estar entre los orígenes
# autorizados de JavaScript. No hace falta client secret: el login usa el flujo implicit.
GOOGLE_CLIENT_ID=

## STORAGE - MinIO
# Root: administran MinIO y crean el bucket. Con datos guardados, NO cambiarlas.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
# Las que usa la api para leer y escribir.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=telescopio

## EMAIL
EMAIL_ENABLED=true
SMTP_HOST=mailserver.grava.io
SMTP_PORT=465
# true = TLS directo (465), false = STARTTLS (587)
SMTP_SECURE=true
SMTP_USER=no-reply-dev@grava.io
SMTP_PASSWORD=change-me
EMAIL_FROM=no-reply-dev@grava.io
EMAIL_FROM_NAME=Telescopio Dev

## PGADMIN (opcional, profile "tools")
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
