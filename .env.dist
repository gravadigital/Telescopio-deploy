IMAGES_TAG=dev
ENVIRONMENT=dev
INGRESS_NETWORK=server-nginx
DOMAIN=telescope.dev.grava.io

## DATABASE VARIABLES
POSTGRES_DB=telescope-db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=change-me

## API VARIABLES
DB_SSLMODE=disable
DB_HOST=telescope-dev-database
GIN_MODE=release
MAX_FILE_SIZE=10485760
CORS_ALLOW_ORIGINS=https://telescope.dev.grava.io
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Length,Content-Type,Authorization
FRONTEND_URL=https://telescope.dev.grava.io

# JWT - generate with: openssl rand -base64 32
JWT_SECRET=change-me

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

## STORAGE - MinIO
MINIO_ENDPOINT=telescope-dev-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=telescopio
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

## EMAIL
EMAIL_ENABLED=true
SMTP_HOST=mailserver.grava.io
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply-dev@grava.io
SMTP_PASSWORD=change-me
EMAIL_FROM=no-reply-dev@grava.io
EMAIL_FROM_NAME=Telescopio Dev

## PGADMIN VARIABLES (optional - profile: tools)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
